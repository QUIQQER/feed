<?xml version="1.0" encoding="UTF-8"?>
<database>

    <global>
        <table name="feeds">
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="string" length="255" default="">project</field>
            <field type="string" length="2" default="">lang</field>
            <field type="text" nullable="true" default="null">feedsites</field>
            <field type="text" nullable="true" default="null">feedsites_exclude</field>
            <field type="string" length="255" nullable="true" default="null">feedName</field>
            <field type="string" length="255" nullable="true" default="null">feedDescription</field>
            <field type="integer" nullable="true" default="null">feedlimit</field>
            <field type="integer" default="0">pageSize</field>
            <field type="boolean" default="0">publish</field>
            <field type="string" length="1023" default="0">publish_sites</field>
            <field type="string" length="255" nullable="true" default="null">feedImage</field>
            <field type="text" nullable="true" default="null">feed_settings</field>
            <field type="string" length="255" nullable="true" default="null">type_id</field>
        </table>
    </global>
</database>
