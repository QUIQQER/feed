<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/feed" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/feed" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="content.feed-publishing">
                <title>Content feed publishing</title>
                <description>
                    Creates and manages configurable RSS, Atom, and CSV feeds from QUIQQER content, with filtering,
                    scheduled regeneration, website discovery links, feed listings, and extensible item collection.
                </description>
            </capability>

            <capability id="seo.xml-sitemaps">
                <title>XML sitemaps</title>
                <description>
                    Generates paginated Google-compatible XML sitemaps for project pages and optional product URLs,
                    including multilingual VHost paths and noindex filtering.
                </description>
            </capability>
        </capabilities>

         <!--Hauptbild -->
        <image src="URL_OPT_DIR/quiqqer/feed/bin/images/Logo.jpg"/>

        <!-- Weitere Vorschaubilder -->
        <preview>
        <image src="URL_OPT_DIR/quiqqer/feed/bin/images/preview/manager.png"/>
        <image src="URL_OPT_DIR/quiqqer/feed/bin/images/preview/create.png"/>
        <image src="URL_OPT_DIR/quiqqer/feed/bin/images/preview/edit.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/feed]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/feed/-/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/feed/-/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer &amp; Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <extra>
            <displayInStore>1</displayInStore>
        </extra>

        <provider>
            <mcp src="\QUI\Feed\MCP\Provider"/>
        </provider>
      
    </package>
</quiqqer>
